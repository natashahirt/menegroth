# Ignore vendored/external code, except Asap
external/*
!external/Asap/
!external/Asap/**

# Ignore secrets
secrets/
.env

# Ignore reference documents (e.g., PDFs) anywhere in the repo
# **/reference/

# Ignore plain text files
*.txt
*.pdf

# Ignore crash dump files
*.stackdump

# Transient run artifacts (test/smoke logs, scratch files, Python caches)
logs/
.tmp_*
**/__pycache__/

# Scratch / one-off runner artifacts (underscore-prefixed scratch + adversarial
# red-team / probe / critic debug scripts that are not reusable tooling)
scripts/runners/_*
scripts/runners/redteam_*
scripts/runners/probe_*
scripts/runners/attack_*
scripts/runners/critic_*
scripts/runners/crit5_*
scripts/runners/crit7_*
scripts/runners/review_verify_*

# Documenter.jl build output
docs/build/

# Grasshopper (.NET) build artifacts
grasshopper/Menegroth.GH/obj/
grasshopper/Menegroth.GH/bin/

# >>> angelo >>>
# Runtime state and derived caches (source of truth is .memory/ and
# .zettelkasten/, which should be committed)
.angelo/
.memory/session-active.json
.memory/active-sessions/

# Legacy locations (pre-.angelo layouts)
.cassius/
.memory.kgl
.memory.index.json
.memory.embeddings.json
.coordinator-state.json
.coordinator-meta.json

# Claude Code local settings (not shared)
.claude/settings.local.json

# Local backups written by `angelo update`
*.angelo-bak
