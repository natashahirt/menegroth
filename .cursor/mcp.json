{
  "mcpServers": {
    "zettelkasten": {
      "command": "/Users/tashahirt/.venvs/angelo/bin/angelo-zettelkasten",
      "env": {
        "ANGELO_WORKSPACE": "${workspaceFolder}",
        "ZETTELKASTEN_PATH": "${workspaceFolder}/.zettelkasten",
        "HF_HUB_OFFLINE": "1",
        "ANGELO_EMBED_SOURCE": "hf"
      }
    },
    "coordinator": {
      "command": "/Users/tashahirt/.venvs/angelo/bin/angelo-coordinator",
      "env": {
        "ANGELO_WORKSPACE": "${workspaceFolder}",
        "ANGELO_ZETTELKASTEN": "1",
        "HF_HUB_OFFLINE": "1",
        "ANGELO_EMBED_SOURCE": "hf"
      }
    },
    "memory": {
      "command": "/Users/tashahirt/.venvs/angelo/bin/angelo-memory",
      "env": {
        "ANGELO_WORKSPACE": "${workspaceFolder}",
        "MEMORY_FILE_PATH": "${workspaceFolder}/.angelo/memory.kgl",
        "HF_HUB_OFFLINE": "1",
        "ANGELO_EMBED_SOURCE": "hf"
      }
    },
    "memory-artifacts": {
      "command": "/Users/tashahirt/.venvs/angelo/bin/angelo-memory-artifacts",
      "env": {
        "ANGELO_WORKSPACE": "${workspaceFolder}"
      }
    }
  }
}
